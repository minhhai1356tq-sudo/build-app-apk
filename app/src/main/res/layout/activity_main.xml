<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0a0518"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER: Logo & Title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_launcher_meow"
                android:background="@drawable/bg_avatar_frame"
                android:padding="4dp"
                android:layout_marginRight="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Minizo Mod"
                    android:textColor="#ec4899"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.05" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Version 1.101"
                    android:textColor="#06b6d4"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ULTRA VIP"
                android:background="@drawable/bg_top_action"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:textColor="#fbbf24"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD: QUYỀN TRUY CẬP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="QUYỀN TRUY CẬP"
                android:textColor="#10b981"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- Item 1: Float Overlay -->
            <LinearLayout
                android:id="@+id/btn_perm_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♟"
                    android:textColor="#10b981"
                    android:textSize="18sp"
                    android:layout_marginRight="12dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hiển thị nút nổi"
                    android:textColor="#F7F7FB"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_display_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHƯA BẬT"
                    android:textColor="#f43f5e"
                    android:textSize="10sp"
                    android:layout_marginRight="8dp"/>
                <View
                    android:id="@+id/dot_display"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />
            </LinearLayout>

            <!-- Item 2: VPN -->
            <LinearLayout
                android:id="@+id/btn_perm_vpn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VPN"
                    android:textColor="#06b6d4"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginRight="12dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kết nối VPN"
                    android:textColor="#F7F7FB"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_vpn_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHƯA BẬT"
                    android:textColor="#f43f5e"
                    android:textSize="10sp"
                    android:layout_marginRight="8dp"/>
                <View
                    android:id="@+id/dot_vpn"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />
            </LinearLayout>

            <!-- Item 3: Notification -->
            <LinearLayout
                android:id="@+id/btn_perm_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="8dp"
                android:background="?android:attr/selectableItemBackground">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textColor="#ec4899"
                    android:textSize="18sp"
                    android:layout_marginRight="12dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nhận thông báo"
                    android:textColor="#F7F7FB"
                    android:textStyle="bold"/>
                <TextView
                    android:id="@+id/tv_notif_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CHƯA BẬT"
                    android:textColor="#f43f5e"
                    android:textSize="10sp"
                    android:layout_marginRight="8dp"/>
                <View
                    android:id="@+id/dot_notif"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />
            </LinearLayout>
            
            <!-- Hidden Views giữ ID cho Java -->
            <View android:id="@+id/dot_storage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_storage_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_storage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>

        <!-- Nút chọn Game -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <Button
                android:id="@+id/btn_show_floating"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_top_action"
                android:text="Chọn Tự Do"
                android:textColor="#06b6d4"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btn_ff_normal"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_top_action"
                android:text="FF Normal"
                android:textColor="#06b6d4"
                android:textSize="11sp" />
            <Button
                android:id="@+id/btn_ff_max"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_top_action"
                android:text="FF Max"
                android:textColor="#06b6d4"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- CARD: ENGINE STATUS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <FrameLayout
                android:id="@+id/btn_engine"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:background="@drawable/bg_power_circle"
                android:layout_marginRight="16dp">
                <ImageView
                    android:id="@+id/iv_engine_power"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:src="@drawable/ic_power_button_outline"
                    android:tint="#f43f5e" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCONNECTED"
                    android:textColor="#f43f5e"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/tv_selected_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET AWAITING"
                    android:textColor="#64748b"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <View
                android:id="@+id/dot_engine"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_off" />
            <View
                android:id="@+id/dot_app"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <!-- CARD: NÚT NỔI MODS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gold"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NÚT NỔI MODS"
                android:textColor="#fbbf24"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <!-- FREEZE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● FREEZE"
                    android:textColor="#06b6d4"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cb_float_freeze"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>
            <TextView android:id="@+id/tv_float_freeze_status" android:layout_width="0dp" android:layout_height="0dp" />

            <!-- GHOST V2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● GHOST V2"
                    android:textColor="#a855f7"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cb_float_ghost"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>
            <TextView android:id="@+id/tv_float_ghost_status" android:layout_width="0dp" android:layout_height="0dp" />

            <!-- TELE INF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="● TELE INF"
                    android:textColor="#fbbf24"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/cb_float_tele_speed"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>
            <TextView android:id="@+id/tv_float_tele_speed_status" android:layout_width="0dp" android:layout_height="0dp" />
            
            <!-- Ẩn các view không dùng -->
            <TextView android:id="@+id/cb_float_tele_v2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_float_tele_v2_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_float_tele" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_float_tele_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_float_delay_ping" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_float_delay_ping_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/group_tele_options" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/group_tele_speed_options" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_tele_replay_delay_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <SeekBar android:id="@+id/seek_tele_replay_delay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_tele_speed_burst_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <SeekBar android:id="@+id/seek_tele_speed_burst" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_tele_speed_sleep_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <SeekBar android:id="@+id/seek_tele_speed_sleep" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_tele_speed_catchup_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_tele_speed_catchup" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>

        <!-- CARD: TÂM ẢO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SIZE &amp; ĐỘ MỜ TÂM ẢO"
                android:textColor="#ec4899"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />
            
            <!-- Size -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="SIZE" android:textColor="#94a3b8"/>
                <SeekBar android:id="@+id/seek_crosshair_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_purple_progress" android:thumb="@drawable/seekbar_purple_thumb"/>
                <TextView android:id="@+id/tv_crosshair_size_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#ec4899" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Opacity -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="ĐỘ MỜ" android:textColor="#94a3b8"/>
                <SeekBar android:id="@+id/seek_crosshair_alpha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_purple_progress" android:thumb="@drawable/seekbar_purple_thumb"/>
                <TextView android:id="@+id/tv_crosshair_alpha_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#ec4899" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Toggle -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="HIỂN THỊ TÂM ẢO" android:textColor="#e2e8f0"/>
                <TextView android:id="@+id/tv_crosshair_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#64748b" android:layout_marginRight="8dp"/>
                <TextView android:id="@+id/cb_crosshair" style="@style/ModernSwitchSmall"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CARD: ĐIỀU CHỈNH NÚT NỔI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ĐIỀU CHỈNH NÚT NỔI" android:textColor="#06b6d4" android:textStyle="bold" android:layout_marginBottom="8dp"/>

            <!-- Float Size -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Cỡ:" android:textColor="#94a3b8"/>
                <SeekBar android:id="@+id/seek_float_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                <TextView android:id="@+id/tv_float_size_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#06b6d4" android:textStyle="bold"/>
            </LinearLayout>

            <!-- Float Alpha -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Mờ:" android:textColor="#94a3b8"/>
                <SeekBar android:id="@+id/seek_float_alpha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                <TextView android:id="@+id/tv_float_alpha_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#06b6d4" android:textStyle="bold"/>
            </LinearLayout>
            
            <!-- Các view ẩn giữ ID -->
            <LinearLayout android:id="@+id/group_mask_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp">
                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                     <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Mask Bar" android:textColor="#e2e8f0"/>
                     <TextView android:id="@+id/tv_mask_bar_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#64748b" android:layout_marginRight="8dp"/>
                     <TextView android:id="@+id/cb_mask_bar" style="@style/ModernSwitchSmall"/>
                 </LinearLayout>
                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                     <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Thickness" android:textColor="#94a3b8" android:textSize="11sp"/>
                     <SeekBar android:id="@+id/seek_mask_bar_thickness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                     <TextView android:id="@+id/tv_mask_bar_thickness_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#06b6d4" android:textStyle="bold"/>
                 </LinearLayout>
                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                     <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="Length" android:textColor="#94a3b8" android:textSize="11sp"/>
                     <SeekBar android:id="@+id/seek_mask_bar_length" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                     <TextView android:id="@+id/tv_mask_bar_length_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#06b6d4" android:textStyle="bold"/>
                 </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/cb_auto_stop_tele" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_auto_stop_tele_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_dev_mode" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_dev_mode_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
