<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05030A"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER: CYBERPUNK TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card"
            android:padding="12dp"
            android:backgroundTint="#110B1F">

            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginRight="12dp"
                android:background="@drawable/bg_avatar_frame">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="6dp"
                    android:src="@drawable/ic_launcher_meow" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MINIZO MOD"
                    android:textColor="#ec4899"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:shadowColor="#ec4899"
                    android:shadowRadius="15"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.1" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="// SYSTEM v1.101"
                    android:textColor="#06b6d4"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIP"
                android:background="@drawable/bg_top_action"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="#fbbf24"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD: QUYỀN TRUY CẬP -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#110B1F">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ QUYỀN TRUY CẬP ]"
                android:textColor="#10b981"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp"
                android:shadowColor="#10b981"
                android:shadowRadius="10" />

            <!-- Item 1: Float Overlay -->
            <LinearLayout
                android:id="@+id/btn_perm_display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="♟"
                    android:textColor="#10b981"
                    android:textSize="20sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hiển thị nút nổi"
                    android:textColor="#e2e8f0"
                    android:textStyle="bold"
                    android:layout_marginLeft="12dp"/>
                <TextView
                    android:id="@+id/tv_display_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#f43f5e"
                    android:textSize="10sp"
                    android:layout_marginRight="8dp"/>
                <View
                    android:id="@+id/dot_display"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />
            </LinearLayout>

            <!-- Item 2: VPN -->
            <LinearLayout
                android:id="@+id/btn_perm_vpn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackground"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="VPN"
                    android:textColor="#06b6d4"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kết nối VPN"
                    android:textColor="#e2e8f0"
                    android:textStyle="bold"
                    android:layout_marginLeft="12dp"/>
                <TextView
                    android:id="@+id/tv_vpn_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#f43f5e"
                    android:textSize="10sp"
                    android:layout_marginRight="8dp"/>
                <View
                    android:id="@+id/dot_vpn"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />
            </LinearLayout>

            <!-- Item 3: Notification -->
            <LinearLayout
                android:id="@+id/btn_perm_notif"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:background="?android:attr/selectableItemBackground">
                <TextView
                    android:layout_width="24dp"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textColor="#ec4899"
                    android:textSize="20sp"
                    android:gravity="center"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nhận thông báo"
                    android:textColor="#e2e8f0"
                    android:textStyle="bold"
                    android:layout_marginLeft="12dp"/>
                <TextView
                    android:id="@+id/tv_notif_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFF"
                    android:textColor="#f43f5e"
                    android:textSize="10sp"
                    android:layout_marginRight="8dp"/>
                <View
                    android:id="@+id/dot_notif"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dot_off" />
            </LinearLayout>
            
            <View android:id="@+id/dot_storage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_storage_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_storage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>

        <!-- GAME SELECTION BUTTONS (NEON STYLE) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">
            <Button
                android:id="@+id/btn_show_floating"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_top_action"
                android:text="TỰ DO"
                android:textColor="#06b6d4"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_ff_normal"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_top_action"
                android:text="FF NORMAL"
                android:textColor="#06b6d4"
                android:textSize="12sp"
                android:textStyle="bold" />
            <Button
                android:id="@+id/btn_ff_max"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_top_action"
                android:text="FF MAX"
                android:textColor="#06b6d4"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CARD: ENGINE STATUS (CORE) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#0A0518">

            <FrameLayout
                android:id="@+id/btn_engine"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_power_circle"
                android:layout_marginRight="16dp">
                <ImageView
                    android:id="@+id/iv_engine_power"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="16dp"
                    android:src="@drawable/ic_power_button_outline"
                    android:tint="#f43f5e" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DISCONNECTED"
                    android:textColor="#f43f5e"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:shadowColor="#f43f5e"
                    android:shadowRadius="12" />
                <TextView
                    android:id="@+id/tv_selected_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TARGET AWAITING"
                    android:textColor="#64748b"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <View
                android:id="@+id/dot_engine"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@drawable/dot_off" />
            <View
                android:id="@+id/dot_app"
                android:layout_width="0dp"
                android:layout_height="0dp" />
        </LinearLayout>

        <!-- CARD: NÚT NỔI MODS (NEON GOLD) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gold"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#1A1206">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ NÚT NỔI MODS ]"
                android:textColor="#fbbf24"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp"
                android:shadowColor="#fbbf24"
                android:shadowRadius="10" />

            <!-- FREEZE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="#0A0518"
                android:paddingHorizontal="12dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="#06b6d4" android:layout_marginRight="10dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="FREEZE"
                    android:textColor="#06b6d4"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView
                    android:id="@+id/cb_float_freeze"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>
            <TextView android:id="@+id/tv_float_freeze_status" android:layout_width="0dp" android:layout_height="0dp" />

            <!-- GHOST V2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp"
                android:background="#0A0518"
                android:paddingHorizontal="12dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="#a855f7" android:layout_marginRight="10dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="GHOST V2"
                    android:textColor="#a855f7"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView
                    android:id="@+id/cb_float_ghost"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>
            <TextView android:id="@+id/tv_float_ghost_status" android:layout_width="0dp" android:layout_height="0dp" />

            <!-- TELE INF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:background="#0A0518"
                android:paddingHorizontal="12dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="#fbbf24" android:layout_marginRight="10dp"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TELE INF"
                    android:textColor="#fbbf24"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView
                    android:id="@+id/cb_float_tele_speed"
                    style="@style/ModernSwitchSmall" />
            </LinearLayout>
            <TextView android:id="@+id/tv_float_tele_speed_status" android:layout_width="0dp" android:layout_height="0dp" />
            
            <!-- Ẩn -->
            <TextView android:id="@+id/cb_float_tele_v2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_float_tele_v2_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_float_tele" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_float_tele_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_float_delay_ping" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_float_delay_ping_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/group_tele_options" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <LinearLayout android:id="@+id/group_tele_speed_options" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_tele_replay_delay_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <SeekBar android:id="@+id/seek_tele_replay_delay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_tele_speed_burst_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <SeekBar android:id="@+id/seek_tele_speed_burst" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_tele_speed_sleep_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <SeekBar android:id="@+id/seek_tele_speed_sleep" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_tele_speed_catchup_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_tele_speed_catchup" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>

        <!-- CARD: TÂM ẢO (NEON PINK) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:backgroundTint="#110B1F">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ SIZE &amp; TÂM ẢO ]"
                android:textColor="#ec4899"
                android:textSize="14sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:layout_marginBottom="12dp"
                android:shadowColor="#ec4899"
                android:shadowRadius="10" />
            
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="SIZE" android:textColor="#94a3b8" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_crosshair_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_purple_progress" android:thumb="@drawable/seekbar_purple_thumb"/>
                <TextView android:id="@+id/tv_crosshair_size_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#ec4899" android:textStyle="bold" android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="ĐỘ MỜ" android:textColor="#94a3b8" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_crosshair_alpha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_purple_progress" android:thumb="@drawable/seekbar_purple_thumb"/>
                <TextView android:id="@+id/tv_crosshair_alpha_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#ec4899" android:textStyle="bold" android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:layout_marginTop="8dp" android:background="#0A0518" android:paddingHorizontal="12dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="HIỂN THỊ TÂM ẢO" android:textColor="#e2e8f0" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_crosshair_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#64748b" android:layout_marginRight="8dp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/cb_crosshair" style="@style/ModernSwitchSmall"/>
            </LinearLayout>
        </LinearLayout>

        <!-- CARD: ĐIỀU CHỈNH NÚT NỔI -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp"
            android:backgroundTint="#110B1F">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="[ CONFIG HUD ]" android:textColor="#06b6d4" android:textStyle="bold" android:fontFamily="monospace" android:layout_marginBottom="8dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Cỡ:" android:textColor="#94a3b8" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_float_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                <TextView android:id="@+id/tv_float_size_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#06b6d4" android:textStyle="bold" android:fontFamily="monospace"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="50dp" android:layout_height="wrap_content" android:text="Mờ:" android:textColor="#94a3b8" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_float_alpha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                <TextView android:id="@+id/tv_float_alpha_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#06b6d4" android:textStyle="bold" android:fontFamily="monospace"/>
            </LinearLayout>
            
            <!-- MASK OPTIONS -->
            <LinearLayout android:id="@+id/group_mask_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp">
                 <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:background="#0A0518" android:paddingHorizontal="12dp">
                     <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MASK BAR" android:textColor="#e2e8f0" android:fontFamily="monospace"/>
                     <TextView android:id="@+id/tv_mask_bar_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#64748b" android:layout_marginRight="8dp" android:fontFamily="monospace"/>
                     <TextView android:id="@+id/cb_mask_bar" style="@style/ModernSwitchSmall"/>
                 </LinearLayout>
                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                     <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="ĐỘ DÀY" android:textColor="#94a3b8" android:textSize="11sp" android:fontFamily="monospace"/>
                     <SeekBar android:id="@+id/seek_mask_bar_thickness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                     <TextView android:id="@+id/tv_mask_bar_thickness_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#06b6d4" android:textStyle="bold" android:fontFamily="monospace"/>
                 </LinearLayout>
                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                     <TextView android:layout_width="70dp" android:layout_height="wrap_content" android:text="ĐỘ DÀI" android:textColor="#94a3b8" android:textSize="11sp" android:fontFamily="monospace"/>
                     <SeekBar android:id="@+id/seek_mask_bar_length" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                     <TextView android:id="@+id/tv_mask_bar_length_value" android:layout_width="50dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#06b6d4" android:textStyle="bold" android:fontFamily="monospace"/>
                 </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/cb_auto_stop_tele" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_auto_stop_tele_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/cb_dev_mode" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
            <TextView android:id="@+id/tv_dev_mode_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
        </LinearLayout>

        <!-- 🚨 2 NÚT ẨN ĐỂ TRÁNH LỖI CRASH CODE JAVA CŨ 🚨 -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

