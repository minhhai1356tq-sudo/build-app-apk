<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050505"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER: HUD STYLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="20dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MINIZO OS"
                android:textColor="#00FFCC"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="monospace"
                android:letterSpacing="0.2"
                android:shadowColor="#00FFCC"
                android:shadowRadius="20" />
                
            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:background="#00FFCC"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp" />
                
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM STATUS: ONLINE // V1.101"
                android:textColor="#555555"
                android:textSize="10sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- KHU VỰC 1: QUYỀN TRUY CẬP (DẠNG NÚT VUÔNG) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">> ACCESS_PERMISSIONS"
            android:textColor="#FF00FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"
            android:shadowColor="#FF00FF"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <!-- Nút Quyền Nổi -->
            <LinearLayout
                android:id="@+id/btn_perm_display"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginRight="6dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="♟"
                    android:textColor="#00FFCC"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OVERLAY"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
                <View
                    android:id="@+id/dot_display"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/dot_off" />
                <TextView android:id="@+id/tv_display_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/cb_display" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>

            <!-- Nút Quyền VPN -->
            <LinearLayout
                android:id="@+id/btn_perm_vpn"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VPN"
                    android:textColor="#00FFCC"
                    android:textSize="18sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TUNNEL"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
                <View
                    android:id="@+id/dot_vpn"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/dot_off" />
                <TextView android:id="@+id/tv_vpn_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/cb_vpn" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>

            <!-- Nút Quyền Thông báo -->
            <LinearLayout
                android:id="@+id/btn_perm_notif"
                android:layout_width="0dp"
                android:layout_height="80dp"
                android:layout_weight="1"
                android:layout_marginLeft="6dp"
                android:background="@drawable/bg_card"
                android:gravity="center"
                android:orientation="vertical"
                android:clickable="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✦"
                    android:textColor="#00FFCC"
                    android:textSize="24sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NOTIFY"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:fontFamily="monospace" />
                <View
                    android:id="@+id/dot_notif"
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/dot_off" />
                <TextView android:id="@+id/tv_notif_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
                <TextView android:id="@+id/cb_notif" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            </LinearLayout>
            
            <!-- View ẩn -->
            <View android:id="@+id/dot_storage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_storage_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_storage" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <!-- KHU VỰC 2: CHỌN GAME (NÚT NGANG) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">> TARGET_SELECTION"
            android:textColor="#FF00FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"
            android:shadowColor="#FF00FF"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">
            <Button
                android:id="@+id/btn_show_floating"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_top_action"
                android:text="FREE"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:fontFamily="monospace" />
            <Button
                android:id="@+id/btn_ff_normal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:background="@drawable/bg_top_action"
                android:text="FF"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:fontFamily="monospace" />
            <Button
                android:id="@+id/btn_ff_max"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginLeft="4dp"
                android:background="@drawable/bg_top_action"
                android:text="FF MAX"
                android:textColor="#00FFCC"
                android:textSize="12sp"
                android:fontFamily="monospace" />
        </LinearLayout>

        <!-- KHU VỰC 3: ENGINE CORE (TRÁI TIM CỦA APP) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#0A0A0A">

            <FrameLayout
                android:id="@+id/btn_engine"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:background="@drawable/bg_power_circle"
                android:layout_marginRight="20dp">
                <ImageView
                    android:id="@+id/iv_engine_power"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp"
                    android:src="@drawable/ic_power_button_outline"
                    android:tint="#FF00FF" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OFFLINE"
                    android:textColor="#FF00FF"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:shadowColor="#FF00FF"
                    android:shadowRadius="15" />
                <TextView
                    android:id="@+id/tv_selected_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AWAITING_TARGET"
                    android:textColor="#555555"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <View
                android:id="@+id/dot_engine"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:background="@drawable/dot_off" />
            <View android:id="@+id/dot_app" android:layout_width="0dp" android:layout_height="0dp" />
        </LinearLayout>

        <!-- KHU VỰC 4: NÚT NỔI MODS (GRID 2 CỘT) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">> MODULE_OVERRIDES"
            android:textColor="#FF00FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"
            android:shadowColor="#FF00FF"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card_gold"
            android:padding="12dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                
                <!-- FREEZE -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginRight="6dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FREEZE"
                        android:textColor="#00FFCC"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                    <TextView android:id="@+id/cb_float_freeze" style="@style/ModernSwitchSmall" />
                </LinearLayout>
                <TextView android:id="@+id/tv_float_freeze_status" android:layout_width="0dp" android:layout_height="0dp" />

                <!-- GHOST V2 -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:background="#1A1A1A"
                    android:gravity="center_vertical"
                    android:padding="10dp">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="GHOST"
                        android:textColor="#FF00FF"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                    <TextView android:id="@+id/cb_float_ghost" style="@style/ModernSwitchSmall" />
                </LinearLayout>
                <TextView android:id="@+id/tv_float_ghost_status" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>

            <!-- TELE INF -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:background="#1A1A1A"
                android:gravity="center_vertical"
                android:padding="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="TELEPORT"
                    android:textColor="#FFAA00"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
                <TextView android:id="@+id/cb_float_tele_speed" style="@style/ModernSwitchSmall" />
            </LinearLayout>
            <TextView android:id="@+id/tv_float_tele_speed_status" android:layout_width="0dp" android:layout_height="0dp" />

            <!-- Ẩn -->
            <TextView android:id="@+id/cb_float_tele_v2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_float_tele_v2_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_float_tele" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_float_tele_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_float_delay_ping" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_float_delay_ping_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/group_tele_options" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <LinearLayout android:id="@+id/group_tele_speed_options" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_tele_replay_delay_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <SeekBar android:id="@+id/seek_tele_replay_delay" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_tele_speed_burst_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <SeekBar android:id="@+id/seek_tele_speed_burst" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_tele_speed_sleep_value" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <SeekBar android:id="@+id/seek_tele_speed_sleep" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_tele_speed_catchup_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_tele_speed_catchup" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <!-- KHU VỰC 5: CẤU HÌNH TÂM & NÚT NỔI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=">> VISUAL_CALIBRATION"
            android:textColor="#FF00FF"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp"
            android:shadowColor="#FF00FF"
            android:shadowRadius="8" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="14dp"
            android:layout_marginBottom="20dp">
            
            <!-- Tâm ảo -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CROSSHAIR" android:textColor="#00FFCC" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="SIZE" android:textColor="#777777" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_crosshair_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_purple_progress" android:thumb="@drawable/seekbar_purple_thumb"/>
                <TextView android:id="@+id/tv_crosshair_size_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#00FFCC" android:fontFamily="monospace"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="ALPHA" android:textColor="#777777" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_crosshair_alpha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_purple_progress" android:thumb="@drawable/seekbar_purple_thumb"/>
                <TextView android:id="@+id/tv_crosshair_alpha_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#00FFCC" android:fontFamily="monospace"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center_vertical">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="ENABLE CROSSHAIR" android:textColor="#FFFFFF" android:fontFamily="monospace"/>
                <TextView android:id="@+id/tv_crosshair_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#777777" android:layout_marginRight="8dp" android:fontFamily="monospace"/>
                <TextView android:id="@+id/cb_crosshair" style="@style/ModernSwitchSmall"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#222222" android:layout_marginTop="10dp" android:layout_marginBottom="10dp"/>

            <!-- Nút nổi -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FLOATING UI" android:textColor="#FF00FF" android:fontFamily="monospace" android:textStyle="bold" android:layout_marginBottom="8dp"/>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="SIZE" android:textColor="#777777" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_float_size" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                <TextView android:id="@+id/tv_float_size_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#FF00FF" android:fontFamily="monospace"/>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="ALPHA" android:textColor="#777777" android:fontFamily="monospace"/>
                <SeekBar android:id="@+id/seek_float_alpha" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                <TextView android:id="@+id/tv_float_alpha_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#FF00FF" android:fontFamily="monospace"/>
            </LinearLayout>
            
            <!-- Mask bar ẩn -->
            <LinearLayout android:id="@+id/group_mask_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="10dp">
                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                     <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MASK BAR" android:textColor="#FFFFFF" android:fontFamily="monospace"/>
                     <TextView android:id="@+id/tv_mask_bar_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#777777" android:layout_marginRight="8dp" android:fontFamily="monospace"/>
                     <TextView android:id="@+id/cb_mask_bar" style="@style/ModernSwitchSmall"/>
                 </LinearLayout>
                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                     <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="THICK" android:textColor="#777777" android:fontFamily="monospace"/>
                     <SeekBar android:id="@+id/seek_mask_bar_thickness" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                     <TextView android:id="@+id/tv_mask_bar_thickness_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#FF00FF" android:fontFamily="monospace"/>
                 </LinearLayout>
                 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
                     <TextView android:layout_width="60dp" android:layout_height="wrap_content" android:text="LENGTH" android:textColor="#777777" android:fontFamily="monospace"/>
                     <SeekBar android:id="@+id/seek_mask_bar_length" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:progressDrawable="@drawable/seekbar_float_progress" android:thumb="@drawable/seekbar_float_thumb"/>
                     <TextView android:id="@+id/tv_mask_bar_length_value" android:layout_width="40dp" android:layout_height="wrap_content" android:gravity="right" android:textColor="#FF00FF" android:fontFamily="monospace"/>
                 </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/cb_auto_stop_tele" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_auto_stop_tele_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/cb_dev_mode" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
            <TextView android:id="@+id/tv_dev_mode_status" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
        </LinearLayout>

        <!-- 🚨 2 NÚT ẨN BẢO HIỂM 🚨 -->
        <Button
            android:id="@+id/btn_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />
        <Button
            android:id="@+id/btn_stop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
